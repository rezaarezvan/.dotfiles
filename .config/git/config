[user]
	name = rezaarezvan
	email = reza@rezvan.xyz
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autoStash = true
	updateRefs = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
	pruneTags = true
[diff]
	algorithm = histogram
	colorMoved = plain
	mnemonicPrefix = true
	renames = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
	autoupdate = true
[commit]
	verbose = true
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[column]
	ui = auto
[help]
	autocorrect = prompt
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
