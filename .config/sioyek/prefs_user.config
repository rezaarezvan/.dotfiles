# Highlight colors (a=yellow, b=green, c=red, d=blue)
highlight_color_a	1.0 1.0 0.4
highlight_color_b	0.4 1.0 0.4
highlight_color_c	1.0 0.4 0.4
highlight_color_d	0.4 0.7 1.0

# UI
page_separator_width	8
status_bar_font_size	14

# Behavior
zoom_inc_factor	1.15
annotations_directory	~/.local/share/sioyek/annotations

# sioyek runs custom commands without a shell, and GUI launches lack the login PATH;
# a failed export notifies (notify-send on Linux, osascript on macOS) instead of failing silently
new_command _save_annots /bin/sh -c PATH="$HOME/.local/bin:/opt/homebrew/bin:$PATH";\ err=$("$HOME/scripts/pdf-annotate"\ "$0"\ 2>&1)\ ||\ notify-send\ "pdf-annotate\ failed"\ "$err"\ 2>/dev/null\ ||\ osascript\ -e\ 'display\ notification\ "see\ the\ PDF\ and\ its\ sidecar"\ with\ title\ "pdf-annotate\ failed"' %{file_path}
