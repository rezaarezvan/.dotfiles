#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pymupdf"]
# ///
import os
import sys
import json
import bisect
import colorsys
import tempfile
from pathlib import Path

import pymupdf

TAG = "sioyek"


def read_prefs():
    prefs = (
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        / "sioyek/prefs_user.config"
    )
    colors, annotations_dir = {}, None
    for line in prefs.read_text().splitlines() if prefs.exists() else ():
        parts = line.split()
        if len(parts) == 4 and parts[0].startswith("highlight_color_"):
            colors[parts[0][-1]] = tuple(map(float, parts[1:]))
        elif len(parts) == 2 and parts[0] == "annotations_directory":
            annotations_dir = Path(parts[1]).expanduser()
    return colors, annotations_dir


def sidecar_path(pdf, annotations_dir):
    if annotations_dir is None:
        return pdf.with_name(pdf.name + ".sioyek.annotations")
    flat = str(pdf).replace("/", "_").replace("\\", "_").replace(":", "_")
    return annotations_dir / (flat + ".sioyek.annotations")


def lighten(rgb):
    factor = int(0.9 / max(colorsys.rgb_to_hls(*rgb)[1], 1e-6) * 100) / 100
    if factor <= 1:
        return rgb
    h, s, v = colorsys.rgb_to_hsv(*rgb)
    v *= factor
    return (
        colorsys.hsv_to_rgb(h, max(0.0, s - (v - 1)), 1.0)
        if v > 1
        else colorsys.hsv_to_rgb(h, s, v)
    )


def page_layout(doc):
    widths, tops, acc = [], [], 0
    for page in doc:
        widths.append(int(page.bound().width))
        tops.append(acc)
        acc += int(page.bound().height)

    def to_page(x, y, i=None):
        if i is None:
            i = max(0, bisect.bisect_left(tops, y) - 1)
        return i, pymupdf.Point(widths[i] / 2 + x, y - tops[i])

    return to_page


def word_quads(page, start, stop):
    words = page.get_text("words", sort=False)
    if not words:
        return []
    rects = [pymupdf.Rect(w[:4]) for w in words]
    nearest = lambda p: min(range(len(rects)), key=lambda k: p.distance_to(rects[k]))
    a, b = sorted((nearest(start), nearest(stop)))
    lines = {}
    for w, r in zip(words[a : b + 1], rects[a : b + 1]):
        lines[w[5], w[6]] = lines.get((w[5], w[6]), r) | r
    return [r.quad for r in lines.values()]


def export_highlight(pages, to_page, h, colors):
    i, begin = to_page(h["selection_begin_x"], h["selection_begin_y"])
    j, end = to_page(h["selection_end_x"], h["selection_end_y"])
    page = pages[i]
    if not (quads := word_quads(page, begin, end if i == j else page.rect.br)):
        return None
    end = to_page(h["selection_end_x"], h["selection_end_y"], i)[1]
    quads = [pymupdf.Rect(begin, begin).quad, *quads, pymupdf.Rect(end, end).quad]

    kind = chr(h["type"])
    if kind == "_":
        annot = page.add_strikeout_annot(quads)
    elif kind.isupper():
        annot = page.add_underline_annot(quads)
    else:
        annot = page.add_highlight_annot(quads)
    annot.set_colors(stroke=lighten(colors.get(kind.lower(), (1.0, 1.0, 0.4))))
    annot.set_info(content=h.get("text_annot", ""))
    return annot


def export_bookmark(pages, to_page, b, colors):
    text = b.get("description", "")
    if b["begin_y"] < 0:
        return None
    i, p0 = to_page(b["begin_x"], b["begin_y"])
    if b["end_y"] < 0:
        # import takes the icon's centre as the bookmark position
        annot = pages[i].add_text_annot(p0, text)
        r = annot.rect
        d = p0 - (r.tl + r.br) / 2
        annot.set_rect(pymupdf.Rect(r.tl + d, r.br + d))
        return annot
    rect = pymupdf.Rect(p0, to_page(b["end_x"], b["end_y"], i)[1])
    if text.startswith("#"):
        # boxes are squares, which import ignores
        annot = pages[i].add_rect_annot(rect)
        annot.set_colors(stroke=colors.get(text[1:2], (0, 0, 0)))
        annot.set_info(content=text)
        return annot
    rgb = (b.get("color_red", 0), b.get("color_green", 0), b.get("color_blue", 0))
    return pages[i].add_freetext_annot(
        rect, text, fontsize=max(b.get("font_size", 11), 1), text_color=rgb
    )


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: pdf-annotate <file.pdf>")
    pdf = Path(sys.argv[1]).absolute()
    colors, annotations_dir = read_prefs()
    if not (sidecar := sidecar_path(pdf, annotations_dir)).exists():
        sys.exit(f"{sidecar} not found, run write_annotations_file in sioyek first")
    data = json.loads(sidecar.read_text())
    doc = pymupdf.open(pdf)
    pages, to_page = list(doc), page_layout(doc)

    for page in pages:
        for annot in [a for a in page.annots() if a.info.get("title") == TAG]:
            page.delete_annot(annot)

    exported = [
        export_highlight(pages, to_page, h, colors) for h in data.get("highlights", [])
    ]
    exported += [
        export_bookmark(pages, to_page, b, colors) for b in data.get("bookmarks", [])
    ]
    for annot in filter(None, exported):
        annot.set_info(title=TAG)
        annot.update()

    if doc.can_save_incrementally():
        return doc.saveIncr()
    fd, tmp = tempfile.mkstemp(suffix=".pdf", dir=pdf.parent)
    os.close(fd)
    doc.save(tmp, garbage=1, deflate=True)
    doc.close()
    os.replace(tmp, pdf)


if __name__ == "__main__":
    main()
