#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.10"
# dependencies = ["pymupdf"]
# ///
import os
import sys
import json
import bisect
import getpass
import colorsys
import tempfile
import string
from pathlib import Path

import pymupdf

TAG = "sioyek"
# sioyek's built-in highlight_color_a..z, for letters not set in prefs_user.config
DEFAULT_COLORS = [
    (0.94, 0.64, 1.00),
    (0.00, 0.46, 0.86),
    (0.60, 0.25, 0.00),
    (0.30, 0.00, 0.36),
    (0.10, 0.10, 0.10),
    (0.00, 0.36, 0.19),
    (0.17, 0.81, 0.28),
    (1.00, 0.80, 0.60),
    (0.50, 0.50, 0.50),
    (0.58, 1.00, 0.71),
    (0.56, 0.49, 0.00),
    (0.62, 0.80, 0.00),
    (0.76, 0.00, 0.53),
    (0.00, 0.20, 0.50),
    (1.00, 0.64, 0.02),
    (1.00, 0.66, 0.73),
    (0.26, 0.40, 0.00),
    (1.00, 0.00, 0.06),
    (0.37, 0.95, 0.95),
    (0.00, 0.60, 0.56),
    (0.88, 1.00, 0.40),
    (0.45, 0.04, 1.00),
    (0.60, 0.00, 0.00),
    (1.00, 1.00, 0.50),
    (1.00, 1.00, 0.00),
    (1.00, 0.31, 0.02),
]


def read_prefs():
    prefs = (
        Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
        / "sioyek/prefs_user.config"
    )
    colors, annotations_dir = dict(zip(string.ascii_lowercase, DEFAULT_COLORS)), None
    for line in prefs.read_text().splitlines() if prefs.exists() else ():
        parts = line.split()
        if len(parts) == 4 and parts[0].startswith("highlight_color_"):
            colors[parts[0][-1]] = tuple(map(float, parts[1:]))
        elif len(parts) == 2 and parts[0] == "annotations_directory":
            annotations_dir = Path(parts[1]).expanduser()
    return colors, annotations_dir


def sidecar_path(pdf, annotations_dir):
    if annotations_dir is None:
        return pdf.with_name(pdf.name + ".sioyek.annotations")
    flat = str(pdf).replace("/", "_").replace("\\", "_").replace(":", "_")
    return annotations_dir / (flat + ".sioyek.annotations")


def lighten(rgb):
    factor = int(0.9 / max(colorsys.rgb_to_hls(*rgb)[1], 1e-6) * 100) / 100
    if factor <= 1:
        return rgb
    h, s, v = colorsys.rgb_to_hsv(*rgb)
    v *= factor
    return (
        colorsys.hsv_to_rgb(h, max(0.0, s - (v - 1)), 1.0)
        if v > 1
        else colorsys.hsv_to_rgb(h, s, v)
    )


def page_layout(doc):
    widths, tops, acc = [], [], 0
    for page in doc:
        widths.append(page.bound().width)
        tops.append(acc)
        acc += page.bound().height

    def to_page(x, y, i=None):
        if i is None:
            i = max(0, bisect.bisect_left(tops, y) - 1)
        return i, pymupdf.Point(widths[i] / 2 + x, y - tops[i])

    def to_abs(i, x, y):
        return x - widths[i] / 2, y + tops[i]

    return to_page, to_abs


def import_key(annot, i, to_abs):
    # the (begin, end) sioyek's import_annotations reads from an annotation
    kind, r = annot.type[0], annot.rect
    if kind in (
        pymupdf.PDF_ANNOT_HIGHLIGHT,
        pymupdf.PDF_ANNOT_UNDERLINE,
        pymupdf.PDF_ANNOT_STRIKE_OUT,
    ):
        if not (v := annot.vertices):
            return None
        ul, ll, ur, lr = v[0], v[2], v[-3], v[-1]
        return (
            *to_abs(i, ul[0], (ul[1] + ll[1]) / 2),
            *to_abs(i, ur[0], (ur[1] + lr[1]) / 2),
        )
    if kind == pymupdf.PDF_ANNOT_TEXT:
        return (*to_abs(i, (r.x0 + r.x1) / 2, (r.y0 + r.y1) / 2), -1, -1)
    if kind == pymupdf.PDF_ANNOT_FREE_TEXT:
        return (*to_abs(i, r.x0, r.y0), *to_abs(i, r.x1, r.y1))
    return None


def is_in(key, keys):
    # sioyek's are_same
    return key is not None and any(
        all(abs(a - b) < 0.01 for a, b in zip(key, k)) for k in keys
    )


def word_quads(page, start, stop):
    words = page.get_text("words", sort=False)
    if not words:
        return []
    rects = [pymupdf.Rect(w[:4]) for w in words]
    nearest = lambda p: min(range(len(rects)), key=lambda k: p.distance_to(rects[k]))
    a, b = sorted((nearest(start), nearest(stop)))
    lines = {}
    for w, r in zip(words[a : b + 1], rects[a : b + 1]):
        lines[w[5], w[6]] = lines.get((w[5], w[6]), r) | r
    return [r.quad for r in lines.values()]


def export_highlight(pages, to_page, h, colors):
    i, begin = to_page(h["selection_begin_x"], h["selection_begin_y"])
    j, end = to_page(h["selection_end_x"], h["selection_end_y"])
    page = pages[i]
    if not (quads := word_quads(page, begin, end if i == j else page.rect.br)):
        return None
    end = to_page(h["selection_end_x"], h["selection_end_y"], i)[1]
    quads = [pymupdf.Rect(begin, begin).quad, *quads, pymupdf.Rect(end, end).quad]

    kind = chr(h["type"])
    if kind == "_":
        annot = page.add_strikeout_annot(quads)
    elif kind.isupper():
        annot = page.add_underline_annot(quads)
    else:
        annot = page.add_highlight_annot(quads)
    annot.set_colors(stroke=lighten(colors[kind.lower()]))
    annot.set_info(content=h.get("text_annot", ""))
    return annot


def export_bookmark(pages, to_page, b, colors):
    text = b.get("description", "")
    if b["begin_y"] < 0:
        return None
    i, p0 = to_page(b["begin_x"], b["begin_y"])
    if b["end_y"] < 0:
        # import takes the icon's centre as the bookmark position
        annot = pages[i].add_text_annot(p0, text)
        r = annot.rect
        d = p0 - (r.tl + r.br) / 2
        annot.set_rect(pymupdf.Rect(r.tl + d, r.br + d))
        return annot
    rect = pymupdf.Rect(p0, to_page(b["end_x"], b["end_y"], i)[1])
    if text.startswith("#"):
        # boxes are squares, which import ignores
        annot = pages[i].add_rect_annot(rect)
        annot.set_colors(stroke=colors.get(text[1:2], (0, 0, 0)))
        annot.set_info(content=text)
        return annot
    rgb = (b.get("color_red", 0), b.get("color_green", 0), b.get("color_blue", 0))
    return pages[i].add_freetext_annot(
        rect, text, fontsize=max(b.get("font_size", 11), 1), text_color=rgb
    )


def main():
    if len(sys.argv) != 2:
        sys.exit("usage: pdf-annotate <file.pdf>")
    pdf = Path(sys.argv[1]).absolute()
    colors, annotations_dir = read_prefs()
    if not (sidecar := sidecar_path(pdf, annotations_dir)).exists():
        sys.exit(f"{sidecar} not found, run write_annotations_file in sioyek first")
    data = json.loads(sidecar.read_text())
    doc = pymupdf.open(pdf)
    pages, (to_page, to_abs) = list(doc), page_layout(doc)

    highlights, bookmarks = data.get("highlights", []), data.get("bookmarks", [])
    known = [
        (h["selection_begin_x"], h["selection_begin_y"])
        + (h["selection_end_x"], h["selection_end_y"])
        for h in highlights
    ] + [(b["begin_x"], b["begin_y"], b["end_x"], b["end_y"]) for b in bookmarks]

    # replace our previous export, and take over annotations from elsewhere that sioyek
    # has imported (`gi`), so deleting or editing them in sioyek reaches the PDF too;
    # author and dates are kept, ours are marked by subject (title in older exports)
    previous = []
    for i, page in enumerate(pages):
        for annot in list(page.annots()):
            key = import_key(annot, i, to_abs)
            ours = TAG in (annot.info.get("subject"), annot.info.get("title"))
            if ours or is_in(key, known):
                if key:
                    previous.append((key, annot.info))
                page.delete_annot(annot)

    exported = [export_highlight(pages, to_page, h, colors) for h in highlights]
    exported += [export_bookmark(pages, to_page, b, colors) for b in bookmarks]
    for key, annot in zip(known, exported):
        if annot:
            # sioyek's own timestamps mix UTC and local time, so new ones are dated now
            info = next((info for k, info in previous if is_in(key, [k])), {})
            author = info.get("title")
            created = info.get("creationDate") or pymupdf.get_pdf_now()
            annot.set_info(
                title=author if author not in (None, "", TAG) else getpass.getuser(),
                subject=TAG,
                creationDate=created,
                modDate=info.get("modDate") or created,
            )
            annot.update()

    # a full rewrite, as incremental saves append a revision on every export
    fd, tmp = tempfile.mkstemp(suffix=".pdf", dir=pdf.parent)
    os.close(fd)
    doc.save(tmp, garbage=1, deflate=True)
    doc.close()
    os.replace(tmp, pdf)


if __name__ == "__main__":
    main()
